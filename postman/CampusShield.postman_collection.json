{
  "info": {
    "name": "SecureByte API",
    "description": "Campus emergency alerts & incident reporting \u2014 hackathon prototype API collection.\n\nQuick start:\n1. Set the baseUrl variable (default http://localhost:4000)\n2. Run 'Login Student' and 'Login Responder' \u2014 tokens are saved automatically\n3. Run requests in order; incident ids are captured automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "responderToken",
      "value": ""
    },
    {
      "key": "incidentId",
      "value": ""
    },
    {
      "key": "setupCode",
      "value": "REPLACE_WITH_RESPONDER_SETUP_CODE"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json().data;",
                  "  if (d.user.role === 'STUDENT') pm.collectionVariables.set('studentToken', d.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Rao\",\n  \"email\": \"aarav@campus.edu\",\n  \"password\": \"Passw0rd1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Setup Responder (controlled)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json().data;",
                  "  pm.collectionVariables.set('responderToken', d.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Safety Desk\",\n  \"email\": \"desk@campus.edu\",\n  \"password\": \"Passw0rd1\",\n  \"setupCode\": \"{{setupCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/setup-responder",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "setup-responder"
              ]
            }
          }
        },
        {
          "name": "Login Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json().data;",
                  "  pm.collectionVariables.set('studentToken', d.accessToken);",
                  "  pm.collectionVariables.set('oldRefresh', d.refreshToken);",
                  "  pm.collectionVariables.set('studentRefresh', d.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@securebyte.dev\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login Responder",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json().data;",
                  "  pm.collectionVariables.set('responderToken', d.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"responder@securebyte.dev\",\n  \"password\": \"Responder@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Me (student)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Refresh Session (rotation)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{studentRefresh}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.success) {",
                  "  pm.collectionVariables.set('studentToken', d.data.accessToken);",
                  "  pm.collectionVariables.set('studentRefresh', d.refreshToken);",
                  "  pm.test('rotation issued a NEW refresh token', () => {",
                  "    pm.expect(d.data.refreshToken).to.not.eql(pm.collectionVariables.get('oldRefresh'));",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout (revoke refresh)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{studentRefresh}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Student@123\",\n  \"newPassword\": \"NewPass456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Incidents (Student)",
      "item": [
        {
          "name": "Trigger SOS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('incidentId', pm.response.json().data.incident.id);",
                  "}",
                  "pm.test('SOS gets CRITICAL priority', function () {",
                  "  pm.expect(pm.response.json().data.incident.priority).to.eql('CRITICAL');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isSos\": true,\n  \"location\": {\n    \"latitude\": 23.8143,\n    \"longitude\": 86.4407,\n    \"campusLandmark\": \"Hostel Gate 3\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ]
            }
          }
        },
        {
          "name": "Create Incident (normal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('incidentId', pm.response.json().data.incident.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Broken window in Lab 4\",\n  \"description\": \"A large window pane in Lab 4 is shattered and students pass right next to it.\",\n  \"category\": \"FACILITY_CONCERN\",\n  \"priority\": \"HIGH\",\n  \"location\": {\n    \"campusLandmark\": \"Science Block\",\n    \"buildingOrRoom\": \"Lab 4\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ]
            }
          }
        },
        {
          "name": "My Reports",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/incidents/my?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents",
                "my"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get Incident by ID",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents",
                "{{incidentId}}"
              ]
            }
          }
        },
        {
          "name": "Create Incident \u2014 invalid coords (expect 422)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bad coordinates\",\n  \"description\": \"Latitude out of range must be rejected by validation.\",\n  \"category\": \"OTHER\",\n  \"location\": { \"latitude\": 999, \"longitude\": 86 }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ]
            }
          }
        }
      ]
    },
