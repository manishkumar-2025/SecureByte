            "url": {
              "raw": "{{baseUrl}}/api/responder/incidents/{{incidentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "responder",
                "incidents",
                "{{incidentId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Update Status \u2192 Resolved",
          "request": {
            "method": "PATCH",
