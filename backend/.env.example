# ─────────────────────────────────────────────────────────────
# SecureByte backend — environment variables
# Copy this file to .env  (cp .env.example .env) and fill in
# REAL values. The .env file is git-ignored. Never commit it.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://campusshield:CHANGE_ME_DB_PASSWORD@localhost:5432/campusshield_dev?schema=public

# JWT — generate a long random string (min 32 chars).
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_chars
JWT_EXPIRES_IN=12h

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed web origins ('*' for local dev only)
CORS_ORIGIN=*

# bcrypt cost factor (10–12 recommended in production)
BCRYPT_ROUNDS=10

# Controlled responder account setup.
# If set, POST /api/auth/setup-responder with this code creates RESPONDER accounts.
# Leave EMPTY to disable the endpoint completely.
RESPONDER_SETUP_CODE=

# Rate limiting (requests per window)
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=5
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60
RATE_LIMIT_INCIDENT_MAX=6
RATE_LIMIT_INCIDENT_WINDOW_MINUTES=10

# Anti-duplicate window: identical incidents from the same user within
# this many seconds are rejected with 409 CONFLICT.
DUPLICATE_WINDOW_SECONDS=30

# ── Sessions ─────────────────────────────────────────────────
# Refresh tokens let the mobile app renew sessions silently.
# Access token stays short-ish; refresh token lives longer (days).
REFRESH_TOKEN_DAYS=30

# ── Account lockout ──────────────────────────────────────────
# After N consecutive failed logins the account is locked for M minutes.
LOGIN_MAX_FAILED=5
LOCKOUT_MINUTES=15

# ── Push notifications (Expo) ────────────────────────────────
# Optional. Create an access token at https://expo.dev → Access Tokens and
# set it here to raise Expo's push rate limits. Without it, push still works
# for Expo Go tokens at a lower rate.
EXPO_PUSH_ACCESS_TOKEN=
# Set to true to disable outbound push completely (e.g. CI runs).
PUSH_DISABLED=false
