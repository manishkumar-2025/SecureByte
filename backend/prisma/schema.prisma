// ─────────────────────────────────────────────────────────────
// SecureByte — Prisma schema (PostgreSQL)
// Tables: users, incidents, incident_locations,
//         incident_status_history, announcements,
//         push_tokens, refresh_tokens,
//         emergency_contacts, check_ins, safety_points,
//         notifications
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  RESPONDER
  // ADMIN sees everything a RESPONDER sees, plus campus-wide analytics
  // and the user directory. Admins are provisioned via the seed script
  // (or by promoting an account directly in the database) — there is
  // deliberately NO public endpoint that grants the ADMIN role.
  ADMIN
}

enum CheckInStatus {
  SAFE
  NEEDS_HELP
}

enum SafetyPointCategory {
  EMERGENCY_EXIT
  FIRE_EXTINGUISHER
  AED
  FIRST_AID
  SHELTER
  SECURITY_OFFICE
}

enum NotificationType {
  SOS_ALERT
  NEW_INCIDENT
  STATUS_UPDATE
  CHECK_IN_ALERT
  ANNOUNCEMENT
  SYSTEM
}

enum IncidentCategory {
  MEDICAL_EMERGENCY
  FIRE_HAZARD
  SECURITY_THREAT
  HARASSMENT
  FACILITY_CONCERN
  OTHER
  // Internal category used for Emergency SOS alerts (not selectable
  // in the manual report form). SOS incidents always get CRITICAL priority.
  SOS_ALERT
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
}

enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  passwordHash     String
  role             Role      @default(STUDENT)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  // Per-user notification preferences. Kept as JSON so the mobile app can
  // evolve the shape without a migration for every new toggle.
  // Shape: { push, sosAlerts, statusUpdates, announcements }
  notificationPrefs Json      @default("{\"push\":true,\"sosAlerts\":true,\"statusUpdates\":true,\"announcements\":true}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  incidentsReported Incident[]              @relation("Reporter")
  statusUpdates     IncidentStatusHistory[]
  announcements     Announcement[]
  pushTokens        PushToken[]
  refreshTokens     RefreshToken[]
  emergencyContacts EmergencyContact[]
  checkIns          CheckIn[]
  notifications     Notification[]

  @@index([role])
  @@map("users")
}

/// Device push tokens (Expo). One row per device token; re-registering
/// the same token re-points it at the current account (upsert).
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

/// Refresh tokens. Only a SHA-256 hash is stored — a database leak must
/// never yield usable session credentials. Refreshing ROTATES the token:
/// the old row is revoked and a new one issued.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Incident {
  id          String           @id @default(uuid())
  reporterId  String
  title       String
  description String
  category    IncidentCategory
  priority    IncidentPriority @default(MEDIUM)
  status      IncidentStatus   @default(NEW)
  isSos       Boolean          @default(false)
  // Server-relative path of an uploaded photo evidence file
  // (e.g. "/uploads/ab12cd34-….jpg"). Null until a photo is attached.
  // Files live on disk (uploads/); only the path is stored here.
  photoPath   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter      User                    @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  location      IncidentLocation?
  statusHistory IncidentStatusHistory[]

  @@index([reporterId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([isSos, createdAt])
  @@map("incidents")
}

model IncidentLocation {
  id             String   @id @default(uuid())
  incidentId     String   @unique
  latitude       Float?
  longitude      Float?
  campusLandmark String?
  buildingOrRoom String?
  createdAt      DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@map("incident_locations")
}

model IncidentStatusHistory {
  id             String         @id @default(uuid())
  incidentId     String
  updatedBy      String
  previousStatus IncidentStatus
  newStatus      IncidentStatus
  responderNotes String?
  createdAt      DateTime       @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  updater  User     @relation(fields: [updatedBy], references: [id])

  @@index([incidentId])
  @@map("incident_status_history")
}

model Announcement {
  id        String               @id @default(uuid())
  authorId  String
  title     String
  message   String
  severity  AnnouncementSeverity @default(INFO)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([createdAt])
  @@map("announcements")
}

/// Trusted people a student can quickly reach during an emergency.
/// Contacts are personal data: users can only ever see and manage their
/// OWN contacts (enforced in the API layer, not just the UI).
model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  name      String
  // Stored as typed digits, normalized to digits-only with an optional
  // leading +. Validated server-side (7–15 digits).
  phone     String
  relation  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_contacts")
}

/// Safety check-ins. A student marks themselves SAFE (reassurance signal,
/// e.g. during a campus-wide alert) or NEEDS_HELP, which alerts every
/// responder + admin through the notification center and push.
model CheckIn {
  id        String        @id @default(uuid())
  userId    String
  status    CheckInStatus
  note      String?
  latitude  Float?
  longitude Float?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("check_ins")
}

/// Static map of campus safety resources (exits, AEDs, first-aid stations,
/// shelters, security offices). Managed by seed/script — read-only for the
/// app. Coordinates are WGS-84 decimal degrees.
model SafetyPoint {
  id          String              @id @default(uuid())
  name        String
  category    SafetyPointCategory
  latitude    Float
  longitude   Float
  description String?
  createdAt   DateTime            @default(now())

  @@index([category])
  @@map("safety_points")
}

/// In-app notification center. Created alongside best-effort push sends,
/// so the record survives even if a device was offline or push was
/// unavailable. Users see only their own rows.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  incidentId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}
